Package: mixparfmCWM
Title: Finite Mixtures of Parametric Frailty Models with Random Covariates
Version: 0.1.0
Authors@R:
    c(person("Andrea", "Cappozzo", , "andrea.cappozzo@unicatt.it", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-9348-710X")),
      person("Chiara", "Masci", , "chiara.masci@unimi.it", role = c("aut"),
